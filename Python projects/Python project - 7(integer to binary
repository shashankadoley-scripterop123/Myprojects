#The following code changes the entered integr of the user to binary using bin function
def integer_to_binary(user_input):
    binary = bin(user_input).replace('0b', ' ')
    #Uses bin function and also replaces '0b'(which is a prefix we get after converting to binary ) with blank space
    print('The entered number in binary is', binary)
integer_to_binary(user_input = int(input('Enter an integer')))
